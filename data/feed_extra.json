    {"de": "Tomaten auf den Augen haben", "literal": "Tomaten auf den Augen", "meaning": "to not notice something obvious", "example": "Hast du Tomaten auf den Augen? Die Brille liegt doch vor dir!"},
    {"de": "Ich verstehe nur Bahnhof.", "literal": "Ich verstehe nur „Bahnhof“", "meaning": "I don't understand a thing", "example": "Bei Physik verstehe ich nur Bahnhof."},
    {"de": "Das ist nicht mein Bier.", "literal": "Das ist nicht mein Bier", "meaning": "That's not my problem", "example": "Wie er das löst, ist nicht mein Bier."},
    {"de": "Da steppt der Bär.", "literal": "Da tanzt der Bär Stepptanz", "meaning": "It's a really lively party", "example": "Am Samstag im Club steppt der Bär."},
    {"de": "jemandem die Daumen drücken", "literal": "jemandem die Daumen drücken", "meaning": "to keep one's fingers crossed for someone", "example": "Ich drücke dir die Daumen für die Prüfung!"},
    {"de": "Schwein haben", "literal": "ein Schwein haben", "meaning": "to be lucky", "example": "Der Bus war weg, aber ich hatte Schwein: Der nächste kam sofort."},
    {"de": "die Nase voll haben", "literal": "die Nase ist voll", "meaning": "to be fed up", "example": "Ich habe die Nase voll vom Regen."},
    {"de": "ins Fettnäpfchen treten", "literal": "in eine kleine Schale mit Fett treten", "meaning": "to put one's foot in it (a social blunder)", "example": "Mit der Frage nach seinem Alter bin ich ins Fettnäpfchen getreten."},
    {"de": "um den heißen Brei herumreden", "literal": "um den heißen Brei herum reden", "meaning": "to beat around the bush", "example": "Red nicht um den heißen Brei herum, sag es einfach!"},
    {"de": "Alles in Butter!", "literal": "Alles ist in Butter", "meaning": "Everything's fine!", "example": "Keine Sorge, alles in Butter."},
    {"de": "den Nagel auf den Kopf treffen", "literal": "den Nagel auf den Kopf treffen", "meaning": "to hit the nail on the head", "example": "Mit deiner Antwort hast du den Nagel auf den Kopf getroffen."},
    {"de": "auf dem Holzweg sein", "literal": "auf einem Weg aus Holz sein", "meaning": "to be on the wrong track", "example": "Wenn du das glaubst, bist du auf dem Holzweg."},
    {"de": "Ich glaube, mein Schwein pfeift!", "literal": "Mein Schwein pfeift", "meaning": "I can't believe it!", "example": "Ich glaube, mein Schwein pfeift! Er ist schon wieder zu spät."},
    {"de": "kein Blatt vor den Mund nehmen", "literal": "kein Blatt vor den Mund halten", "meaning": "to speak one's mind openly", "example": "Meine Oma nimmt kein Blatt vor den Mund."},
    {"de": "die Katze im Sack kaufen", "literal": "eine Katze im Sack kaufen", "meaning": "to buy something without checking it first", "example": "Ein Auto ohne Probefahrt? Ich kaufe doch nicht die Katze im Sack!"},
    {"de": "jemandem auf den Keks gehen", "literal": "auf jemandes Keks gehen", "meaning": "to get on someone's nerves", "example": "Der laute Nachbar geht mir auf den Keks."},
    {"de": "Hier ist tote Hose.", "literal": "Hier ist eine tote Hose", "meaning": "Nothing is going on here", "example": "Am Sonntag ist in unserem Dorf tote Hose."},
    {"de": "Das ist mir Wurst.", "literal": "Das ist mir Wurst", "meaning": "I don't care", "example": "Ob wir Pizza oder Pasta essen, ist mir Wurst."},
    {"de": "sich zum Affen machen", "literal": "sich zu einem Affen machen", "meaning": "to make a fool of oneself", "example": "Beim Karaoke habe ich mich zum Affen gemacht."},
    {"de": "zwei Fliegen mit einer Klappe schlagen", "literal": "zwei Fliegen mit einer Klappe schlagen", "meaning": "to kill two birds with one stone", "example": "Ich fahre mit dem Rad zur Arbeit und schlage so zwei Fliegen mit einer Klappe."},
    {"de": "jemandem einen Bären aufbinden", "literal": "jemandem einen Bären auf den Rücken binden", "meaning": "to tell someone a tall tale", "example": "Du willst mir doch einen Bären aufbinden!"},
    {"de": "unter vier Augen", "literal": "unter vier Augen", "meaning": "in private, just the two of us", "example": "Können wir kurz unter vier Augen sprechen?"},
    {"de": "einen Kater haben", "literal": "einen Kater (männliche Katze) haben", "meaning": "to have a hangover", "example": "Nach der Party hatte er einen Kater."},
    {"de": "auf Wolke sieben schweben", "literal": "auf der siebten Wolke schweben", "meaning": "to be on cloud nine", "example": "Seit sie verliebt ist, schwebt sie auf Wolke sieben."},
    {"de": "Hals- und Beinbruch!", "literal": "Bruch von Hals und Bein", "meaning": "Good luck! (break a leg)", "example": "Hals- und Beinbruch für dein Vorstellungsgespräch!"},
